# Local hermetic Playwright defaults. Never point these values at production.
E2E_BASE_URL=http://127.0.0.1:5174
E2E_PORT=5174
E2E_BACKEND_PORT=8001
E2E_DB_PATH=/tmp/crushme-e2e.sqlite3
E2E_REUSE_SERVER=0
E2E_USERNAME=e2e_user
E2E_USER_PASSWORD=E2E-password-123!

# Remote staging is opt-in and read-only unless the second flag is explicit.
E2E_REMOTE_STAGING=0
E2E_ALLOW_STAGING_WRITES=0
