# Isolated E2E environment. Copy to .env.e2e; never point it at production.
DJANGO_ENV=test
DJANGO_SETTINGS_MODULE=crushme_project.settings_test
DJANGO_SECRET_KEY=e2e-only-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The test settings force SQLite, in-memory cache/Huey, and local email.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=:memory:
FAKE_DATA_ALLOWED=true

# External integrations stay disabled or sandboxed.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_KEY=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_ENVIRONMENT=sandbox

ARGOS_CHUNK_TYPE=MINISBD
ARGOS_DEVICE_TYPE=cpu

BACKUPS_ENABLED=false
ENABLE_SLOW_QUERIES_REPORT=false
ENABLE_SILK=false
