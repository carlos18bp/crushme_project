# =============================================================================
# crushme_project — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit the real .env file.

# --- Core Django ---
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (development: SQLite; production: MySQL) ---
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DB_NAME=crushme
DB_USER=crushme_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Redis ---
REDIS_URL=redis://localhost:6379/2
REDIS_CACHE_URL=redis://localhost:6379/1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Authentication, abuse prevention, and uploads ---
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTRATION=5/hour
THROTTLE_AUTH_VERIFICATION=10/hour
THROTTLE_AUTH_PASSWORD_RESET=5/hour
THROTTLE_AUTH_TOKEN_REFRESH=30/hour
THROTTLE_PAYMENT_CREATE=20/hour
THROTTLE_PAYMENT_CONFIRM=60/hour
THROTTLE_PAYMENT_WEBHOOK=120/min
THROTTLE_UPLOAD=30/hour
THROTTLE_PUBLIC_WRITE=20/hour
THROTTLE_PUBLIC_SEARCH=60/min
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_IMAGE_PIXELS=25000000
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=200
DATA_UPLOAD_MAX_NUMBER_FILES=12
MAX_GALLERY_UPLOADS_PER_REQUEST=10

# --- Email (GoDaddy SMTP) ---
EMAIL_HOST_USER=support@crushme.com.co
EMAIL_HOST_PASSWORD=

# --- Silk profiling ---
ENABLE_SILK=false

# --- Backups ---
BACKUP_STORAGE_PATH=/var/backups/crushme_project

# --- Payment gateways ---
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_KEY=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_ENVIRONMENT=sandbox
DROPSHIPPING_PRODUCT_ID=48500

# Production must explicitly set live gateway endpoints and credentials.

# --- Offline translation safety ---
TRANSLATION_ENGINE=ctranslate2_cpu
TRANSLATION_SOCKET_PATH=/run/crushme-translation/translation.sock
TRANSLATION_MODEL_DIR=/home/ryzepeck/.local/share/crushme/translation-models
TRANSLATION_TIMEOUT_SECONDS=30
# Stage-1 rollback settings. Remove after the observation window closes.
ARGOS_CHUNK_TYPE=MINISBD
ARGOS_DEVICE_TYPE=cpu

# --- Fake data safety ---
FAKE_DATA_ALLOWED=true
FAKE_DATA_PROTECTED_DATABASES=crushme,crushme_db,crushme_production

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
