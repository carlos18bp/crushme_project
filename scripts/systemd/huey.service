[Unit]
Description=Huey consumer for crushme_project
Wants=crushme-translation.service
After=network.target redis-server.service crushme-translation.service
Requires=redis-server.service

[Service]
Type=simple
User=ryzepeck
Group=www-data
WorkingDirectory=/home/ryzepeck/webapps/crushme_project/backend
EnvironmentFile=/home/ryzepeck/webapps/crushme_project/backend/.env
Environment="DJANGO_SETTINGS_MODULE=crushme_project.settings"
Environment="DJANGO_ENV=production"
ExecStart=/home/ryzepeck/webapps/crushme_project/backend/venv_cpu/bin/python manage.py run_huey --workers 1
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=-/home/ryzepeck/webapps/crushme_project/backend/media
ReadWritePaths=-/home/ryzepeck/webapps/crushme_project/backend/logs
ReadWritePaths=-/home/ryzepeck/.cache/Microsoft/DeveloperTools/.onnxruntime

[Install]
WantedBy=multi-user.target
