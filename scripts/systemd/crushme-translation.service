[Unit]
Description=CrushMe CPU-only offline translation daemon
After=network.target
Before=crushme_project.service crushme-huey.service
PartOf=crushme_project.service

[Service]
Type=simple
User=ryzepeck
Group=www-data
WorkingDirectory=/home/ryzepeck/webapps/crushme_project/backend
Environment=DJANGO_LOG_LEVEL=INFO
ExecStart=/home/ryzepeck/webapps/crushme_project/backend/venv_translation/bin/python -m crushme_app.services.translation_daemon --socket /run/crushme-translation/translation.sock --model-dir /home/ryzepeck/.local/share/crushme/translation-models
RuntimeDirectory=crushme-translation
RuntimeDirectoryMode=0750
UMask=0007
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

MemoryHigh=200M
MemoryMax=320M
CPUQuota=40%
TasksMax=32
OOMScoreAdjust=300

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=-/run/crushme-translation

[Install]
WantedBy=multi-user.target
