[Unit]
Description=Daily Django database and media backup for crushme_project
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=ryzepeck
Group=www-data
WorkingDirectory=/home/ryzepeck/webapps/crushme_project/backend
EnvironmentFile=/home/ryzepeck/webapps/crushme_project/backend/.env
Environment="DJANGO_SETTINGS_MODULE=crushme_project.settings"
Environment="DJANGO_ENV=production"
ExecStart=/home/ryzepeck/webapps/crushme_project/backend/venv_cpu/bin/python manage.py dbbackup --compress --clean
ExecStartPost=/home/ryzepeck/webapps/crushme_project/backend/venv_cpu/bin/python manage.py mediabackup --compress --clean
StandardOutput=journal
StandardError=journal
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/backups/crushme_project
ReadWritePaths=-/home/ryzepeck/webapps/crushme_project/backend/logs

[Install]
WantedBy=multi-user.target
