[Unit]
Description=Gunicorn daemon for crushme_project
Requires=crushme_project.socket
Wants=crushme-translation.service
After=network.target crushme-translation.service

[Service]
Type=notify
User=ryzepeck
Group=www-data
WorkingDirectory=/home/ryzepeck/webapps/crushme_project/backend
EnvironmentFile=/home/ryzepeck/webapps/crushme_project/backend/.env
Environment="DJANGO_SETTINGS_MODULE=crushme_project.settings"
Environment="DJANGO_ENV=production"
ExecStart=/home/ryzepeck/webapps/crushme_project/backend/venv_cpu/bin/gunicorn \
    --workers 2 \
    --max-requests 800 \
    --max-requests-jitter 80 \
    --timeout 120 \
    --graceful-timeout 30 \
    --bind unix:/run/gunicorn.sock \
    crushme_project.wsgi:application
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=-/home/ryzepeck/webapps/crushme_project/backend/media
ReadWritePaths=-/home/ryzepeck/webapps/crushme_project/backend/logs
ReadWritePaths=-/home/ryzepeck/.cache/Microsoft/DeveloperTools/.onnxruntime

[Install]
WantedBy=multi-user.target
